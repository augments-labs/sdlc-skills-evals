#!/usr/bin/env bash
# shellcheck disable=SC2034
# timeout_s/maxturns are consumed by adapters in this shell (and shape the
# isolated opencode config); referenced indirectly, never in this file.
# Trigger eval — scores a DESCRIPTION, not a run.
#
# THIS IS AN OPTIMIZATION INSTRUMENT, NOT A TEST: its query sets live under
# descriptions/, apart from the evals. It implements the standard's
# description-tuning loop: score, revise against TRAIN failures, repeat,
# then select the iteration with the best VALIDATION rate. Both splits are
# consumed by that loop, so neither is a held-out result and a red sheet
# here is not a regression — see descriptions/README.md.
#
# ============================ THIS COSTS REAL MONEY ============================
# Every query is a live session against your own harness account, and the default
# is 20 queries x 3 runs = 60 CALLS PER SKILL. `--all` runs every set under
# DESCRIPTIONS_ROOT: thousands of calls, hours of wall time, and enough usage
# to exhaust a plan's quota.
#
# Price any selection first:  --dry-run  prints the budget and calls nothing.
# ==============================================================================
#
# A description's job is to fire on the openings it should and stay quiet on the
# ones it shouldn't. Routing is non-deterministic, so neither fact is observable
# in one run: the unit of evidence is a QUERY REPEATED N TIMES, reduced to a
# trigger rate. A query passes when the rate lands on the right side of 0.5 —
# above for a should-trigger query, below for a should-not.
#
# The near-miss negatives are the point. A description that fires on its own
# happy-path opening has proven nothing; every description does that. What
# separates a tuned description from a greedy one is the query that shares its
# vocabulary and needs a different skill.
#
# Query sets live under DESCRIPTIONS_ROOT at <skill>.json (held-out sets at
# holdout/<skill>.json) — an array of
#   { "query": TEXT, "should_trigger": BOOL, "split": "train"|"validation"|"holdout",
#     "expect": SKILL|"none" }   # `expect` = the correct route, diagnostic only
# `should_trigger` is about THIS skill. `expect` records where a negative should
# have gone instead, so a miss and a misroute are distinguishable in the report.
#
# The split is fixed in the files and never reshuffled between iterations —
# rotating it turns validation into a second training set. Tune against train;
# report validation; pick the iteration with the best VALIDATION pass rate, which
# is often not the last one.
#
# Manual tool, never CI.
#
# Flags and exit codes: --help.

set -uo pipefail
if [ -n "${SDLC_SKILLS_EVALS_ROOT:-}" ]; then
  lab_root="$SDLC_SKILLS_EVALS_ROOT"
else
  lab_root="$(cd "$(dirname "$0")/.." && pwd)"
fi
descroot="${DESCRIPTIONS_ROOT:-$lab_root/descriptions}"
harnessdir="$lab_root/harnesses"
# shellcheck source=../lib/pin.sh
source "$lab_root/lib/pin.sh"

usage() {
  cat <<'EOF'
bin/triggering — score a skill DESCRIPTION against its query set.

  --harness NAME    a harness adapter under harnesses/ whose header says
                    runnable=yes (see harnesses/README.md)       (required)
  --skill NAME      the skill to score                            (or --all)
  --plugin P        path or git ref of the plugin tree under test
                    (default: the pinned upstream commit, a commit and
                    never a tag)
  --all             every query set under DESCRIPTIONS_ROOT
  --split WHICH     all | train | validation | holdout           (default: all)
  --runs N          repetitions per query                         (default: 3)
  --jobs N          repetitions to run concurrently               (default: 3, 1 = serial)
  --timeout N       seconds per run                               (default: 120)
  --max-turns N     turns before a run is cut off                 (default: 6)
  --json PATH       write the per-query records as a JSON array
  --summary PATH    write the run's summary as one JSON object: which skill
                    text and which description it scored, the count per
                    split, one row per query. bin/report --triggering copies
                    it into a record. One skill only (not with --all); PATH
                    must be writable, which is checked before anything runs.
  --dry-run         print the plan — the pin and the exact command —
                    and call nothing
  --no-fixture      run queries in a bare directory instead of a seeded project
  --harness-dir D   harness directory (default: harnesses;
                    a test seam for offline runs)
  --help            this text

COST: live sessions against your own harness account. One skill at the defaults
is 20 queries x 3 runs = 60 calls; --all is every set. Always --dry-run
first: it prints the exact count.

The summary (--summary):
  metadata {skill, harness, harness_version, model, plugin: {commit,
            skill_tree}, description_sha256, runs, threshold}
  splits   {train|validation|holdout: {queries, passed, failed,
            inconclusive, pass_rate}}       only the splits a query ran in
  queries  [{query, should_trigger, split, trigger_rate, verdict}]
plugin is the full commit and the git tree hash of the skill's directory at
that commit; both are null when --plugin is a directory whose skill directory
is not exactly a git work tree's HEAD, before the run and after it, and
skill_tree alone is null when --plugin is a commit that does not hold the
skill.
description_sha256 is the SHA-256 of the exact bytes of the frontmatter line
that begins `description:` in the skill's `SKILL.md`, without its newline.
The frontmatter is the block a first line of exactly `---` opens and the
next line of exactly `---`, or the end of the file, closes; the line is the
first one in it that begins `description:`, and its newline is the one LF
byte that ends it. It is null when the installed tree has no such line (a
file with CRLF line endings has none: its first line is not exactly `---`),
or when the line changed during the run.
harness_version and model are null when the adapter reads none; model is
also null unless every scored run named the same one. pass_rate is passed /
(passed + failed), null when every query in the split was INCONCLUSIVE;
trigger_rate is null for an INCONCLUSIVE query. No transcript, stream, or
observed routing enters it.
--dry-run with --summary prints the identity a run would record. The plan and
the run both say when the summary is one bin/report will not record for want
of a skill tree or of the validation split (--split train or holdout); only
a run reads the description, so only a run says when it has no hash.

Exit codes: 0 every scored query passed · 1 at least one FAIL
            2 bad or missing arguments, a --summary that could not be
              written, or harness unrunnable (indeterminate)
            3 jq or the harness CLI is unavailable

Examples:
  bin/triggering --harness opencode --skill yagni --dry-run
  bin/triggering --harness opencode --skill yagni
  bin/triggering --harness opencode --skill yagni --split train
  bin/triggering --harness opencode --skill yagni --json out.json
  bin/triggering --harness opencode --skill yagni --summary workspaces/yagni-triggering.json
EOF
  _pin_line
}

# The pin a run uses when the caller names none: the committed upstream
# commit, read from config/upstream-inventory.json. It is a commit, never
# a mutable tag, so a run never selects new work from a moving ref.
_pin_line() {
  local pin
  if pin="$(lab_inventory_commit 2>/dev/null)"; then
    printf 'default pin: %s  (config/upstream-inventory.json)\n' "$pin"
  else
    printf 'default pin: (unreadable — config/upstream-inventory.json names no commit)\n'
  fi
}

harness=""; skill=""; runs=3; split="all"; dry=""; jsonout=""; all=""; fixture="1"; jobs=3
timeout_s=120; maxturns=6; plugin=""; harnessdir_override=""; summary=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help)    usage; exit 0;;
    --harness)    harness="$2"; shift 2;;
    --skill)      skill="$2"; shift 2;;
    --plugin)     plugin="$2"; shift 2;;
    --all)        all="1"; shift;;
    --runs)       runs="$2"; shift 2;;
    --jobs)       jobs="$2"; shift 2;;
    --split)      split="$2"; shift 2;;
    --timeout)    timeout_s="$2"; shift 2;;
    --max-turns)  maxturns="$2"; shift 2;;
    --dry-run)    dry="1"; shift;;
    --json)       jsonout="$2"; shift 2;;
    --summary)    summary="${2:-}"
                  case "$summary" in
                    '') echo "--summary needs a path" >&2; exit 2;;
                    -*) echo "--summary needs a path, and $summary reads as an option (write ./$summary for a file of that name)" >&2; exit 2;;
                  esac
                  shift 2;;
    --no-fixture) fixture=""; shift;;
    --harness-dir) harnessdir_override="$2"; shift 2;;
    *) echo "unknown argument: $1" >&2; exit 2;;
  esac
done
[ -n "$harness" ] || { echo "needs --harness NAME" >&2; exit 2; }
[ -n "$skill" ] || [ -n "$all" ] || { echo "needs --skill NAME or --all" >&2; exit 2; }
command -v jq >/dev/null 2>&1 || { echo "needs \`jq\`" >&2; exit 3; }
case "$split" in all|train|validation|holdout) ;; *) echo "--split all|train|validation|holdout" >&2; exit 2;; esac
# A summary names one skill's text, and it is written after the run is paid
# for: refuse what cannot be written before anything is launched.
if [ -n "$summary" ]; then
  [ -z "$all" ] || { echo "--summary is one skill's record: use --skill, not --all" >&2; exit 2; }
  sumdir="$(dirname -- "$summary")"
  [ -d "$sumdir" ] || { echo "--summary $summary: its directory does not exist" >&2; exit 2; }
  [ ! -d "$summary" ] || { echo "--summary $summary is a directory: it names the file to write" >&2; exit 2; }
  if [ -e "$summary" ]; then [ -w "$summary" ]; else [ -w "$sumdir" ]; fi \
    || { echo "--summary $summary cannot be written" >&2; exit 2; }
fi
# Counters this script feeds straight to `seq` and to arithmetic. A non-numeric
# --runs yields an empty `seq`, which scores every query zero-valid and reports a
# full sheet of INCONCLUSIVE — a wrong measurement that still looks like a
# measurement, rather than an error anyone would notice.
for n in runs jobs timeout_s maxturns; do
  case "${!n}" in ''|*[!0-9]*|0) echo "--${n%_s} needs a positive integer" >&2; exit 2;; esac
done
# The plugin a run uses: the caller's, or the committed upstream commit.
# The default is a commit, never a mutable tag, so a run never selects new
# work from a moving ref.
plugin_defaulted=""
if [ -z "$plugin" ]; then
  plugin="$(lab_inventory_commit 2>/dev/null)" || {
    echo "no usable upstream pin: config/upstream-inventory.json names no commit" >&2; exit 2; }
  plugin_defaulted="1"
fi
# The tree a run installs, and where it came from. A directory is the
# operator's own working tree and is used as it is, so the tree is the
# path; a ref is pinned into a worktree, so the tree is the commit it
# names. The runner names the tree, never a commit it would describe
# content the run never measured.
if [ -n "$plugin_defaulted" ]; then
  plugin_tree="$plugin"
  plugin_note="config/upstream-inventory.json"
else
  plugin_tree="$(lab_pin_tree "$plugin" 2>/dev/null)" || plugin_tree="$plugin"
  plugin_note="$(lab_pin_note --plugin "$plugin")"
fi
[ -n "$harnessdir_override" ] && harnessdir="$harnessdir_override"

# Which skill text a summary names, and why when it cannot name one.
identify() { # $1 path|commit — sets id_json ({commit, skill_tree}) and id_why
  local out
  out="$(lab_pin_identity "$1" "$skill" 2>&1)"
  id_json="$(tail -n 1 <<<"$out")"
  id_why="$(sed '$d' <<<"$out" | head -n 1)"
  id_why="${id_why#*: }" # the reason, without its "no identity for <tree>: " or "no skill tree for <skill>: "
}
identity_line() { # $1 identity json $2 why — one line for the operator
  if jq -e '.skill_tree != null' <<<"$1" >/dev/null 2>&1; then
    printf '%s  skill_tree %s\n' "$(jq -r .commit <<<"$1")" "$(jq -r .skill_tree <<<"$1")"
  else
    printf 'unidentified (%s) — bin/report will not record this summary\n' "${2:-unknown}"
  fi
}
# A record reports the validation split: say so when this run scores none.
no_validation_line() {
  case "$split" in
    train|holdout) echo "summary  : no validation split (--split $split) — bin/report will not record this summary";;
  esac
}
# The skill's SKILL.md in an installed tree: skills/<skill> or
# skills/<phase>/<skill>, and only when the tree holds exactly one.
skill_md_in() { # $1 tree
  local f hits=()
  for f in "$1/skills/$skill/SKILL.md" "$1"/skills/*/"$skill"/SKILL.md; do
    [ -f "$f" ] && hits+=("$f")
  done
  [ "${#hits[@]}" -eq 1 ] && printf '%s\n' "${hits[0]}"
}

# The corpus is flat: one <skill>.json per skill at the root, held-out sets
# under holdout/. Only those two depths are read — a stray nested set is not
# a query set, so it can never be scored by accident.
sets=()
setdir="$descroot"
[ "$split" = holdout ] && setdir="$descroot/holdout"
if [ -n "$all" ]; then
  if [ -d "$setdir" ]; then
    while IFS= read -r f; do sets+=("$f"); done \
      < <(find "$setdir" -mindepth 1 -maxdepth 1 -name '*.json' -type f | sort)
  fi
else
  [ -f "$descroot/$skill.json" ] || [ -f "$descroot/holdout/$skill.json" ] \
    || { echo "no query set for skill: $skill" >&2; exit 2; }
  [ -f "$setdir/$skill.json" ] && sets+=("$setdir/$skill.json")
fi

# jq filter selecting the queries this invocation runs.
sel='.[] | select($split == "all" or .split == $split)'

if [ -n "$dry" ]; then
  # The plan, priced: no pin, no checkout, no CLI, no credential, no
  # model. It names the tree a live run would install and the exact
  # command it would be.
  plan_cmd="bin/triggering --harness $(printf '%q' "$harness")"
  if [ -n "$all" ]; then plan_cmd="$plan_cmd --all"; else plan_cmd="$plan_cmd --skill $(printf '%q' "$skill")"; fi
  # The command carries the TREE the plan names — a commit for a ref, a
  # path for a directory — so a ref that moves after the plan cannot
  # change what the plan installs.
  plan_cmd="$plan_cmd --plugin $(printf '%q' "$plugin_tree") --runs $runs --jobs $jobs --split $split"
  plan_cmd="$plan_cmd --timeout $timeout_s --max-turns $maxturns"
  [ -n "$jsonout" ] && plan_cmd="$plan_cmd --json $(printf '%q' "$jsonout")"
  [ -n "$summary" ] && plan_cmd="$plan_cmd --summary $(printf '%q' "$summary")"
  [ -z "$fixture" ] && plan_cmd="$plan_cmd --no-fixture"
  [ -n "$harnessdir_override" ] && plan_cmd="$plan_cmd --harness-dir $(printf '%q' "$harnessdir_override")"
  echo "plugin   : $plugin_tree  ($plugin_note)"
  if [ -n "$summary" ]; then
    identify "$plugin_tree"
    echo "identity : $(identity_line "$id_json" "$id_why")"
    no_validation_line
  fi
  echo "harness  : $harness"
  echo "command  : $plan_cmd"
  total=0
  for f in "${sets[@]}"; do
    n="$(jq --arg split "$split" "[$sel] | length" "$f")"
    printf '%-34s %3d queries x %d runs = %4d calls\n' \
      "$(basename "$f" .json)" "$n" "$runs" "$((n * runs))"
    total=$((total + n * runs))
  done
  printf '\n%d API call(s) total, billed to your own harness account. A negative\n' "$total"
  printf 'query runs to --max-turns, so budget roughly a full short session each.\n'
  exit 0
fi

[ -f "$harnessdir/$harness.sh" ] || { echo "no harness adapter: $harness" >&2; exit 2; }
if [ "$(grep '^runnable=' "$harnessdir/$harness.sh" | sed 's/^runnable=//')" != "yes" ]; then
  reason="$(grep '^runnable_reason=' "$harnessdir/$harness.sh" | sed 's/^runnable_reason=//')"
  echo "harness $harness is unrunnable here (${reason:-no reason}) — every query INCONCLUSIVE" >&2
  exit 2
fi
# shellcheck source=/dev/null
. "$harnessdir/$harness.sh"
# shellcheck source=../lib/common.sh
. "$lab_root/lib/common.sh"
# shellcheck source=/dev/null
. "$lab_root/fixtures/fixtures.sh"
adapter_check || exit 3
# Default for the optional structural refusal check (see `observe_once`).
# Conservative on purpose: an adapter that does not implement it is assumed to
# have run, so no harness silently loses runs from its denominator.
declare -F adapter_ran >/dev/null 2>&1 || adapter_ran() { return 0; }
# Optional too: an adapter that binds neither reports no version and no
# model, and a summary says null. The version is read only for a summary;
# the model is read from every run's stream.
declare -F adapter_version >/dev/null 2>&1 || adapter_version() { :; }
declare -F adapter_session_model >/dev/null 2>&1 || adapter_session_model() { :; }

# --- the observation primitive ------------------------------------------------
# ONE query, ONE run, emitting one JSON record. Non-deterministic by nature, so a
# single run is never a verdict — the scoring loop below repeats it and reduces
# the repetitions to a rate.
#
# Detection reads a STRUCTURED tool call from the harness's own stream, never a
# prose grep and never a self-report. A raw grep reports phantom activations: the
# SessionStart nudge and the init manifest both contain `sdlc-skills:` tokens that
# are not actions. The first version of this harness fell for exactly that.
observe_once() { # $1 query text  $2 subject skill
  local text="$1" subject="$2"
  local workdir stream errlog harness_home="" chain inconclusive="false"
  workdir="$(mktemp -d)"; stream="$(mktemp)"; errlog="$(mktemp)"

  # An EMPTY workdir silently invalidates any realistic query. Asked to "add the
  # config flag" in a bare temp dir, the model correctly answers that there is no
  # project to add it to — and never routes at all, which scores as a trigger miss
  # when nothing was wrong with the description. Queries name real files because
  # the standard's guidance is to make them realistic, so they need a real project.
  ( cd "$workdir" && git init -q -b main 2>/dev/null || { git init -q && git checkout -qb main; }
    if [ -n "$fixture" ]; then
      fixture_node_api "$workdir"; fixture_activation_paths "$workdir"
    else
      printf '# Fixture\n\nA disposable repository for skill-routing probes.\n' > README.md
    fi
    git add -A
    git -c user.name='SDLC skills Harness' -c user.email='harness@example.invalid' \
        commit -q -m 'fixture baseline' ) || { rm -rf "$workdir" "$stream" "$errlog"; return 2; }

  adapter_install "$plugin_src" || { rm -rf "$workdir" "$stream" "$errlog"; return 3; }
  local prompt; prompt="$text$(adapter_prompt_suffix 2>/dev/null || true)"
  local -a xflags; mapfile -t xflags < <(adapter_activation_flags 2>/dev/null || true)

  ( adapter_run_activation "$workdir" "$prompt" "$stream" ${xflags[@]+"${xflags[@]}"} ) &
  local cpid=$!
  # Skills CHAIN: using-sdlc-skills routes, then task-branches, then TDD, then
  # yagni. So stopping at the first non-router skill truncates a correct chain and
  # scores it as a miss — that is exactly what happened to test-driven-development
  # (killed at using-git-worktrees, which the router correctly sends you to first)
  # and to finishing-a-branch (killed at verification-before-completion). Wait for the
  # SUBJECT; --max-turns bounds a run that never reaches it, which is every
  # correctly-behaving negative.
  # Chain names differ per harness (opencode reports bare directory names,
  # others prefix sdlc-skills:) — normalize before comparing with the subject.
  local want="$subject"
  while kill -0 "$cpid" 2>/dev/null; do
    adapter_chain "$stream" | sed 's/^sdlc-skills://' | grep -qx "$want" && { kill "$cpid" 2>/dev/null; break; }
    sleep 2
  done
  wait "$cpid" 2>/dev/null

  chain="$(adapter_chain "$stream" | sed 's/^sdlc-skills://' | awk 'NF && !seen[$0]++')"

  # A run that never reached the model is NOT evidence about a description, and
  # scoring it as "did not fire" is how a dead provider gets reported as a result.
  # Observed: a kimi eval returned exactly 50%/50% — every positive scored a miss,
  # every negative "passed" for free — because all 60 calls died at auth and no
  # assistant record was ever emitted. The rate looked like a measurement.
  #
  # Two independent detectors, because neither is sufficient alone.
  #
  # (a) The provider says so, in its own words. Split by file on purpose: $errlog
  # is the CLI's own stderr, so an auth or quota phrase there is the CLI talking.
  # The same phrase inside $stream may be MODEL OUTPUT quoting an error, so that
  # side keeps only the narrow patterns that appear as error records.
  if grep -qiE 'usage limit|login_required|api_error: 4' "$stream" 2>/dev/null \
    || grep -qiE 'usage limit|login_required|authorization grant|no credential|credential configured|not authenticated|invalid_grant|unauthorized' \
         "$errlog" 2>/dev/null; then
    inconclusive="true"
  fi

  # (b) Structural: did the CLI complete a model turn at all? This catches the
  # failure whose wording nobody has seen yet — (a) was written against kimi's
  # older `auth.login_required` and silently missed 0.34.0's "The provided
  # authorization grant is invalid", which is how the 50%/50% sheet happened.
  #
  # Exit status CANNOT serve here, and that is worth stating so it is not "fixed"
  # later: `claude` exits 1 on max-turns exhaustion, the same code as an auth
  # failure. Since every negative query runs to max-turns by design, keying on
  # status would drop half of every set from the denominator — far worse than the
  # bug. The discriminator is the stream: a max-turns run still emits a full turn
  # and a terminal record; the dead auth run emitted one bare `meta` line.
  #
  # `adapter_ran` is OPTIONAL and defaults to "it ran", so a harness that has not
  # had its failure shape observed behaves exactly as before. Claiming otherwise
  # would be inventing evidence.
  adapter_ran "$stream" || inconclusive="true"

  printf '%s\n' "$chain" | jq -cRn --argjson inconclusive "$inconclusive" \
    --arg model "$(adapter_session_model "$stream" 2>/dev/null | head -n 1)" \
    '{chain: [inputs | select(length > 0)], inconclusive: $inconclusive, model: $model}'

  [ -n "$harness_home" ] && rm -rf "$harness_home"
  rm -rf "$workdir"; rm -f "$stream" "$errlog"
}

# --- scoring loop -------------------------------------------------------------
results="$(mktemp)"; pin_dir=""
trap 'rm -f "$results"; lab_pin_cleanup; [ -z "$pin_dir" ] || rm -rf "$pin_dir"' EXIT
sets_failed=0

# The plugin is a TREE, not a ref: a ref is pinned into a throwaway
# worktree first, so the run uses the commit it names and never a moving
# branch. The worktree is removed at exit, with the registration it made
# in the plugin checkout.
plugin_src="$plugin"
if [ ! -d "$plugin" ]; then
  pin_dir="$(mktemp -d)" || exit 2
  lab_pin_plugin "$plugin" "$pin_dir" >"$pin_dir/commit.txt" 2>/dev/null || {
    echo "cannot pin --plugin '$plugin' (the plugin checkout has no such commit)" >&2; exit 2; }
  plugin_src="$pin_dir/plugin"
fi
# The tree this run installs, named in the output: a working tree when the
# plugin is a directory, the pinned commit when it is a ref.
printf 'plugin   : %s  (%s)\n' "$plugin_tree" "$plugin_note"
# What a summary will name: the skill text by commit and tree hash, and the
# description line by its bytes, both read again after the run. A ref is
# named by the commit it was pinned to, so a branch that moves cannot be
# named for a tree the run did not install.
run_models="" # one line per scored run: the model it named, or empty
if [ -n "$summary" ]; then
  id_src="$plugin"
  [ -z "$pin_dir" ] || id_src="$(cat "$pin_dir/commit.txt")"
  identify "$id_src"; plugin_id="$id_json"
  echo "identity : $(identity_line "$plugin_id" "$id_why")"
  no_validation_line
  skill_md="$(skill_md_in "$plugin_src")"
  description_sha256="$(lab_description_sha256 "$skill_md" 2>/dev/null)"
  if [ -z "$description_sha256" ]; then
    desc_why="the frontmatter of its SKILL.md has no line that begins description:"
    [ -n "$skill_md" ] || desc_why="the installed tree does not hold exactly one SKILL.md for $skill"
    echo "description: unhashed ($desc_why) — bin/report will not record this summary"
  fi
  harness_version="$(adapter_version 2>/dev/null | head -n 1)"
fi

# A skill with no held-out set scores nothing in the holdout split.
[ "${#sets[@]}" -gt 0 ] || printf '\n  (no queries in this split)\n'
for f in "${sets[@]}"; do
  subject="$(basename "$f" .json)"
  printf '\n=== %s (%s split, %d run(s) per query) ===\n' "$subject" "$split" "$runs"

  qcount=0
  while IFS= read -r q; do
    text="$(jq -r '.query' <<<"$q")"
    want="$(jq -r '.should_trigger' <<<"$q")"
    qsplit="$(jq -r '.split' <<<"$q")"
    route="$(jq -r '.expect // "none"' <<<"$q")"
    qcount=$((qcount + 1))

    # The repetitions of ONE query are independent — each gets its own workdir,
    # harness home, and stream — so they fan out. Repetitions, not queries: a
    # query's verdict is printed as soon as it is decided, so the report stays in
    # file order and reads the same as it did serially.
    #
    # Why this is worth doing: a positive can stop the moment the expected skill
    # fires, but a negative has nothing to wait for and burns --max-turns or the
    # timeout. Half of every set is negatives by design, so the back half of a
    # serial run costs multiples of the front half.
    #
    # Concurrency does not change what is measured — each call is a separate
    # session against the same catalogue — but it can change whether a call
    # COMPLETES, and a timeout is scored as "did not fire" rather than dropped.
    # So keep --jobs equal across the runs you intend to compare: a before/after
    # pair split across two concurrency levels is confounded, and the artifact
    # would look like a description regression.
    fired=0; valid=0; chains=""
    rundir="$(mktemp -d)"
    launched=0
    for i in $(seq 1 "$runs"); do
      ( observe_once "$text" "$subject" 2>/dev/null > "$rundir/$i" ) &
      launched=$((launched + 1))
      # No `$jobs -gt 1` guard: at --jobs 1 this must wait after EVERY launch,
      # which is exactly what `launched % 1 == 0` gives. Guarding it would skip
      # the wait entirely and make the documented serial mode fully concurrent.
      [ "$((launched % jobs))" -eq 0 ] && wait
    done
    wait

    for i in $(seq 1 "$runs"); do
      rec="$(cat "$rundir/$i" 2>/dev/null)"
      # A malformed record means the runner itself failed; that is not a miss.
      jq -e . >/dev/null 2>&1 <<<"$rec" || continue
      [ "$(jq -r '.inconclusive' <<<"$rec")" = "true" ] && continue
      valid=$((valid + 1))
      run_models="$run_models$(jq -r '.model // ""' <<<"$rec")"$'\n'
      chains="$chains$(jq -r '.chain | join(">")' <<<"$rec")"$'\n'
      jq -e --arg s "$subject" 'any(.chain[]; sub("^sdlc-skills:";"") == $s)' >/dev/null <<<"$rec" &&
        fired=$((fired + 1))
    done
    rm -rf "$rundir"

    # Provider refusals are dropped from the denominator, never averaged in as
    # misses. Zero valid runs is an INCONCLUSIVE query, not a failing one.
    if [ "$valid" -eq 0 ]; then
      verdict="INCONCLUSIVE"; rate="-"
    else
      rate="$(awk -v f="$fired" -v v="$valid" 'BEGIN{printf "%.2f", f/v}')"
      if [ "$want" = "true" ]; then
        awk -v r="$rate" 'BEGIN{exit !(r > 0.5)}' && verdict="PASS" || verdict="FAIL"
      else
        awk -v r="$rate" 'BEGIN{exit !(r < 0.5)}' && verdict="PASS" || verdict="FAIL"
      fi
    fi

    printf '  %-12s %s rate=%s (%d/%d)  %s\n' "$verdict" \
      "$([ "$want" = "true" ] && echo '+' || echo '-')" "$rate" "$fired" "$valid" \
      "$(printf '%.68s' "$text" | tr '\n' ' ')"
    # Both failure directions need the observed routing to be actionable. A
    # positive miss is diagnosed by what fired *instead* — that is the whole
    # evidence for revising a trigger — so printing this only for negatives left
    # the more expensive failure with nothing to revise against.
    observed="$(printf '%s' "$chains" | sort -u | paste -sd' | ' -)"
    [ -n "$observed" ] || observed="(nothing routed)"
    if [ "$verdict" = "FAIL" ]; then
      if [ "$want" = "true" ]; then
        printf '               expected %s to fire | observed: %s\n' "$subject" "$observed"
      else
        printf '               should have routed to: %s | observed: %s\n' "$route" "$observed"
      fi
    fi

    jq -cn --arg skill "$subject" --arg split "$qsplit" --arg verdict "$verdict" \
           --arg rate "$rate" --argjson want "$want" --arg query "$text" \
           --arg observed "$observed" \
           --argjson fired "$fired" --argjson valid "$valid" \
      '{skill:$skill, split:$split, should_trigger:$want, query:$query,
        fired:$fired, valid:$valid, rate:$rate, verdict:$verdict,
        observed:$observed}' >> "$results"
  done < <(jq -c --arg split "$split" "$sel" "$f")

  [ "$qcount" -gt 0 ] || printf '  (no queries in this split)\n'
done

# --- summary ------------------------------------------------------------------
# Reported per split because they answer different questions: train drives the
# next revision, validation decides which iteration to keep.
echo
printf '%-12s %-7s %-7s %s\n' "SPLIT" "PASSED" "SCORED" "PASS RATE"
for s in train validation; do
  read -r p t < <(jq -rs --arg s "$s" \
    '[.[] | select(.split == $s and .verdict != "INCONCLUSIVE")]
     | "\([.[] | select(.verdict == "PASS")] | length) \(length)"' "$results")
  [ "${t:-0}" -gt 0 ] &&
    printf '%-12s %-7s %-7s %s\n' "$s" "$p" "$t" \
      "$(awk -v p="$p" -v t="$t" 'BEGIN{printf "%.0f%%", 100*p/t}')"
done
inc="$(jq -rs '[.[] | select(.verdict == "INCONCLUSIVE")] | length' "$results")"
[ "$inc" -gt 0 ] && printf '\n%s quer(y/ies) INCONCLUSIVE — provider refused every run.\n' "$inc"
failed="$(jq -rs '[.[] | select(.verdict == "FAIL")] | length' "$results")"
[ "$failed" -gt 0 ] && sets_failed=1

[ -n "$jsonout" ] && { jq -s '.' "$results" > "$jsonout"; echo "wrote $jsonout"; }

if [ -n "$summary" ]; then
  identify "$id_src"
  if [ "$(jq -cS . <<<"$id_json")" != "$(jq -cS . <<<"$plugin_id")" ]; then
    echo "identity : $(identity_line '{}' "the tree changed during the run")"
    plugin_id='{"commit": null, "skill_tree": null}'
  fi
  if [ "$(lab_description_sha256 "$(skill_md_in "$plugin_src")" 2>/dev/null)" != "$description_sha256" ]; then
    echo "description: its line changed during the run — the summary names no description_sha256"
    description_sha256=""
  fi
  model="$(printf '%s' "$run_models" | sort -u)"
  case "$model" in *$'\n'*) model="";; esac
  jq -s --arg skill "$skill" --arg harness "$harness" --arg hv "$harness_version" --arg model "$model" \
    --arg desc "$description_sha256" --argjson plugin "$plugin_id" --argjson runs "$runs" '
    def known: if . == "" then null else . end;
    def count(f): map(select(f)) | length;
    . as $rows
    | {metadata: {skill: $skill, harness: $harness, harness_version: ($hv | known), model: ($model | known),
         plugin: $plugin, description_sha256: ($desc | known), runs: $runs, threshold: 0.5},
       splits: ([("train", "validation", "holdout") as $s
         | ($rows | map(select(.split == $s))) | select(length > 0)
         | {queries: length, passed: count(.verdict == "PASS"), failed: count(.verdict == "FAIL"),
            inconclusive: count(.verdict == "INCONCLUSIVE")}
         | .pass_rate = (if .passed + .failed > 0 then .passed / (.passed + .failed) else null end)
         | {key: $s, value: .}] | from_entries),
       queries: ($rows | map({query, should_trigger, split,
         trigger_rate: (if .valid > 0 then .fired / .valid else null end), verdict}))}' \
    "$results" > "$summary" || { echo "could not write --summary $summary" >&2; exit 2; }
  echo "wrote $summary"
fi

# Live, non-deterministic runs. A rate is evidence; one eval is not a mandate.
# Revise against TRAIN failures only — tuning on validation overfits it away.
exit "$sets_failed"
