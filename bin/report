#!/usr/bin/env bash
# bin/report — copy an iteration's benchmark into a record directory:
# benchmark.json (required), and benchmark.md and feedback.json when the
# iteration holds them. The copy under results/ is canonical: if any target
# already exists in the record, the report refuses and copies nothing,
# rather than silently overwriting evidence. No live calls.

set -uo pipefail
[ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ] && {
  echo "usage: bin/report --workspace <iteration-dir> --record <record-dir>"; exit 0; }
ws=""; rec=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --workspace) ws="${2:-}"; shift 2 || exit 2;;
    --record) rec="${2:-}"; shift 2 || exit 2;;
    *) echo "unknown argument: $1" >&2; exit 2;;
  esac
done
[ -n "$ws" ] && [ -n "$rec" ] || { echo "needs --workspace and --record" >&2; exit 2; }
[ -f "$ws/benchmark.json" ] || { echo "no benchmark.json in $ws" >&2; exit 2; }
files=(benchmark.json)
for f in benchmark.md feedback.json; do [ -f "$ws/$f" ] && files+=("$f"); done
for f in "${files[@]}"; do
  [ -e "$rec/$f" ] && { echo "refusing: $rec/$f exists" >&2; exit 2; }
done
mkdir -p "$rec" || exit 2
for f in "${files[@]}"; do
  cp "$ws/$f" "$rec/$f" || exit 2
done
