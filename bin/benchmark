#!/usr/bin/env bash
# bin/benchmark — aggregate one iteration directory into benchmark.json and
# benchmark.md.
#
# Reads <eval-id>/{with_skill,without_skill|old_skill}/{grading.json,
# timing.json} and writes benchmark.json:
#   metadata    {iteration, configurations, eval_ids}
#   runs[]      one row per eval and arm: {eval_id, configuration, outcome,
#               pass_rate, passed, failed, needs_review, total,
#               time_seconds, tokens}
#   run_summary {with_skill: {...}, without_skill|old_skill: {...},
#                delta: {pass_rate, time_seconds, tokens}}
# Each arm is {pass_rate, time_seconds, tokens} as {mean, stddev}
# (population) plus indeterminate_count. A null pass rate — an
# indeterminate arm, or an eval with no assertions yet — stays out of the
# mean; an arm with no scored run has a null mean, never zero. Token stats
# run over the runs that reported tokens. The second arm keeps its own name
# (without_skill or old_skill). benchmark.md is the same data for a human:
# a Summary table and a Per-Eval Breakdown. No live calls.

set -uo pipefail
[ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ] && {
  echo "usage: bin/benchmark <iteration-dir>"; exit 0; }
iter="${1:-}"; [ -n "$iter" ] || { echo "needs an iteration dir" >&2; exit 2; }
[ -d "$iter" ] || { echo "no such dir: $iter" >&2; exit 2; }

command -v jq >/dev/null 2>&1 || { echo "needs \`jq\`" >&2; exit 3; }

second_arm=""
for e in "$iter"/*/; do
  [ -d "$e" ] || continue
  for arm in "$e"*/; do
    [ -d "$arm" ] || continue
    a="$(basename "$arm")"
    if [ "$a" != with_skill ]; then
      if [ -z "$second_arm" ]; then second_arm="$a"
      elif [ "$a" != "$second_arm" ]; then
        echo "two second arms ($second_arm, $a) — one iteration compares one pair" >&2; exit 2
      fi
    fi
  done
done
[ -n "$second_arm" ] && [ "$second_arm" != with_skill ] || {
  echo "no with_skill/second-arm pairs in $iter" >&2; exit 2; }

# One row per eval and arm, in eval order then arm order.
runs="$(for e in "$iter"/*/; do
  [ -d "$e" ] || continue
  for a in with_skill "$second_arm"; do
    d="$e$a"
    [ -d "$d" ] || continue
    g='{}'; [ -f "$d/grading.json" ] && g="$(jq -c '.summary // {}' "$d/grading.json")"
    t='null'; [ -f "$d/timing.json" ] && t="$(jq -c . "$d/timing.json")"
    jq -nc --arg eval "$(basename "$e")" --arg arm "$a" --argjson g "$g" --argjson t "$t" '
      {eval_id: $eval, configuration: $arm, outcome: ($g.outcome // "ok"),
       pass_rate: $g.pass_rate, passed: $g.passed, failed: $g.failed,
       needs_review: $g.needs_review, total: $g.total,
       time_seconds: (if $t == null then null else (($t.duration_ms // 0) / 1000) end),
       tokens: (if $t == null then null else $t.total_tokens end)}'
  done
done | jq -s .)"

jq -n --argjson runs "$runs" --arg arm "$second_arm" --arg iter "$(basename "$iter")" '
  def agg: if length == 0 then null
    else (add / length) as $m
    | {mean: $m,
       stddev: (if length == 1 then 0
         else ((map(. - $m) | map(. * .) | add / length) | sqrt) end)} end;
  def stats($c): [$runs[] | select(.configuration == $c)] as $r
    | {pass_rate: ([$r[].pass_rate | numbers] | agg),
       time_seconds: ([$r[].time_seconds | numbers] | agg),
       tokens: ([$r[].tokens | numbers] | agg),
       indeterminate_count: ([$r[] | select(.outcome == "indeterminate")] | length)};
  def meanof(o): if o == null then null else o.mean end;
  def sub(a; b): if a == null or b == null then null else a - b end;
  stats("with_skill") as $with | stats($arm) as $second
  | {metadata: {iteration: $iter, configurations: ["with_skill", $arm],
                eval_ids: ([$runs[].eval_id] | unique)},
     runs: $runs,
     run_summary: ({with_skill: $with} + {($arm): $second}
       + {delta: {pass_rate: sub(meanof($with.pass_rate); meanof($second.pass_rate)),
                  time_seconds: sub(meanof($with.time_seconds); meanof($second.time_seconds)),
                  tokens: sub(meanof($with.tokens); meanof($second.tokens))}})}' \
  > "$iter/benchmark.json" || { echo "cannot aggregate $iter" >&2; exit 2; }

jq -r '
  def num: if . == null then "n/a" elif (. | floor) == . then tostring
    else (. * 1000 | round / 1000 | tostring) end;
  def ms: if . == null then "n/a" else "\(.mean | num) ± \(.stddev | num)" end;
  def pct: if . == null then "n/a" else "\(. * 100 | round)%" end;
  .metadata.configurations as $c | .run_summary as $s
  | "# Benchmark: \(.metadata.iteration)", "",
    "## Summary", "",
    "| configuration | pass rate | time (s) | tokens | indeterminate |",
    "|---|---|---|---|---|",
    ($c[] as $a | $s[$a]
      | "| \($a) | \(.pass_rate | ms) | \(.time_seconds | ms) | \(.tokens | ms) | \(.indeterminate_count) |"),
    "| delta (with_skill − \($c[1])) | \($s.delta.pass_rate | num) | \($s.delta.time_seconds | num) | \($s.delta.tokens | num) | |",
    "",
    "A null pass rate (an indeterminate run, or an eval with no assertions) is left out of the mean.",
    "",
    "## Per-Eval Breakdown", "",
    "| eval | configuration | outcome | pass rate | passed | failed | needs review | time (s) | tokens |",
    "|---|---|---|---|---|---|---|---|---|",
    (.runs[] | "| \(.eval_id) | \(.configuration) | \(.outcome) | \(.pass_rate | pct) | \(.passed | num) | \(.failed | num) | \(.needs_review | num) | \(.time_seconds | num) | \(.tokens | num) |")
' "$iter/benchmark.json" > "$iter/benchmark.md" || { echo "cannot write $iter/benchmark.md" >&2; exit 2; }
