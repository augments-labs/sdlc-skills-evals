#!/bin/sh
# Tripwire for the real `hermes` CLI. Offline suites put this directory first
# on PATH so no real agent CLI is reachable: this runs nothing, records the
# call in the exported, absolute $TRIPWIRE_LOG, and fails with 97.
printf '%s %s\n' "hermes" "$*" >> "${TRIPWIRE_LOG:-/dev/null}"
echo "tripwire: the real hermes CLI was called" >&2
exit 97
